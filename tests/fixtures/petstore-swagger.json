{
  "swagger": "2.0",
  "info": {
    "title": "Test Swagger Petstore",
    "version": "1.0.0"
  },
  "host": "example.com",
  "basePath": "/api",
  "schemes": ["https"],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "A list of pets",
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
